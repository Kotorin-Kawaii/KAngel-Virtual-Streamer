# OpenAI Chat Completions 兼容接口
SERVER__HOST=0.0.0.0
SERVER__PORT=8000


AI__BASE_URL=https://api.example.com/v1
AI__API_KEY=replace-me
AI__DEFAULT_MODEL=replace-with-your-reply-model
# 简单分类任务使用轻量模型，留空时回退到主模型
AI__QA_SELECTOR_MODEL=replace-with-your-fast-model
AI__QA_SELECTOR_TIMEOUT=20
AI__DANMAKU_SELECTOR_MODEL=replace-with-your-fast-model
AI__DANMAKU_SELECTOR_TIMEOUT=20
# 情感影响分析需要更强语义能力，但flash够用，但无需占用最终回复主模型
AI__IMPACT_ANALYSIS_MODEL=replace-with-your-balanced-model
AI__IMPACT_ANALYSIS_TIMEOUT=20
AI__MODERATION_MODEL=replace-with-your-fast-model
AI__MODERATION_TIMEOUT=20
# 下播情景记忆使用独立角色；留空时回退到默认模型
AI__SESSION_MEMORY_MODEL=replace-with-your-fast-model
AI__SESSION_MEMORY_TIMEOUT=60
# 可选 AI Director；只有 STREAM__DIRECTOR_MODE=ai_shadow/ai 时才会使用
AI__STREAM_DIRECTOR_MODEL=replace-with-your-fast-model
AI__STREAM_DIRECTOR_TIMEOUT=12
AI__TEMPERATURE=0.2
AI__STREAMING=False
AI__TIMEOUT=600
AI__PARALLEL_CONTEXT_ANALYSIS=True
AI__INTENT_SHADOW_MODEL=replace-with-your-fast-model
AI__INTENT_SHADOW_ENABLED=False
AI__INTENT_CANDIDATE_APPLY_ENABLED=False
AI__INTENT_SHADOW_TIMEOUT=4
AI__INTENT_SHADOW_CONCURRENCY=1
AI__INTENT_SHADOW_MAX_WAITERS=2
AI__INTENT_SHADOW_MAX_PER_STREAM=12

# 多供应商配置（可选）：设置后按权重和时间段自动选择供应商，请求失败回退到下一个。
# 留空则使用上面的单供应商字段（AI__BASE_URL / AI__API_KEY / AI__DEFAULT_MODEL）。
# weight 越大优先级越高；active_start/active_end 为 HH:MM 本地时间，支持跨午夜。
# models 中未配置的角色（如 qa_selector）自动回退到 default。
# AI__PROVIDERS=[{"name":"primary","base_url":"https://api.example.com/v1","api_key":"replace-me-primary","models":{"default":"replace-with-your-reply-model","qa_selector":"replace-with-your-fast-model"},"enabled":true,"weight":100,"active_start":"06:00","active_end":"23:59"},{"name":"backup","base_url":"https://backup.example.com/v1","api_key":"replace-me-backup","models":{"default":"replace-with-your-reply-model"},"enabled":true,"weight":50,"active_start":"00:00","active_end":"23:59"}]
# 关闭后使用兼容的旧三轴影响值，不采纳模型事件评价。
AI__EVENT_APPRAISAL_ENABLED=True

# 主播管理系统：LLM 只提出语义建议，后端负责累计状态和本站禁言执行
MODERATION__ENABLED=True
MODERATION__ANALYSIS_ENABLED=True
MODERATION__MAX_PENDING_TASKS=64
MODERATION__RESERVATION_TTL_SECONDS=120
MODERATION__RECENT_MESSAGE_LIMIT=8
MODERATION__STATE_RETENTION_DAYS=30
MODERATION__DECAY_PER_MINUTE=2.0
MODERATION__VIOLATION_WINDOW_MINUTES=5
MODERATION__WARNING_THRESHOLD=0.60
MODERATION__TIMEOUT_THRESHOLD=0.80
MODERATION__ADMIN_REVIEW_THRESHOLD=0.95
MODERATION__TIMEOUT_SECONDS=120
MODERATION__MAX_TIMEOUT_SECONDS=600
# 可按直播策略覆盖阈值；硬规则只由后端匹配，不能被关系修正绕过
# MODERATION__HARD_VIOLATION_TERMS=["人肉","地址","手机号","杀了你","弄死你","炸死你"]
# MODERATION__STREAM_PROFILES={"default":{"warning":0.60,"timeout":0.80,"admin_review":0.95},"special_event":{"warning":0.55,"timeout":0.75,"admin_review":0.92}}

# 关闭后主回复提示词不注入 ReplyPlan，回复仍走兼容链路。
PERSONA__REPLY_PLAN_INJECTION_ENABLED=True
# Persona Catalog 灰度：legacy 完全沿用旧 Prompt；shadow 只在内存比较；
# catalog 按直播场次稳定分桶。首轮建议先 shadow，确认后再逐步提高比例。
PERSONA__PROMPT_MODE=legacy
PERSONA__PROMPT_ROLLOUT_PERCENT=0
PERSONA__CATALOG_EVIDENCE_LIMIT=3
PERSONA__CATALOG_EXEMPLAR_ENABLED=False
PERSONA__CATALOG_EXEMPLAR_LIMIT=1

# 情绪覆盖策略：推荐列表跨类别按语气契合度分配名额、冷门标定加权、重复判定
# 收紧到近 10 次出现 2 次。语气过滤优先于多样化，不会把负向动作推给欢快语境。
# 出现「动作与句子语气不符」时可置 False，立刻回到旧的纯线性打分（需重启）。
PERSONA__EMOTION_DIVERSITY_ENABLED=True
# 冷门加成上限（0-3）；需大于类别内基础分差（约 1.2）才能让零加成的中性动作
# 抢到推荐列表头部，0 表示完全不考虑冷门程度。
PERSONA__EMOTION_COLD_BONUS=1.5

# 人格动力学档案：enhanced 为当前默认；legacy 仅用于回退和对照。
# 档案在进程启动时读取，修改后须重启；不会增加模型调用或改变前端协议。
PERSONA__DYNAMICS__PROFILE=enhanced
# 人格动力学。先通过回放确认后再调大/调小，不建议仅为“更有情绪”直接提高单步上限。
PERSONA__DYNAMICS__MAX_STEP_MOOD=0.08
PERSONA__DYNAMICS__MAX_STEP_STRESS=0.10
PERSONA__DYNAMICS__MAX_STEP_DARKNESS=0.07
PERSONA__DYNAMICS__RECOVERY_RATE_MOOD=0.012
PERSONA__DYNAMICS__RECOVERY_RATE_STRESS=0.018
PERSONA__DYNAMICS__RECOVERY_RATE_DARKNESS=0.010
PERSONA__DYNAMICS__RECOVERY_TIME_REFERENCE_SECONDS=30
PERSONA__DYNAMICS__RECOVERY_TIME_FACTOR_MAX=3
PERSONA__DYNAMICS__REPEATED_TOPIC_MULTIPLIER=0.65
PERSONA__DYNAMICS__BOUNDARY_FACTOR_MIN=0.35
# 只有接近极端边界才触发安全回归；不要把主播在中度低落/高压时强拉回中间值。
PERSONA__DYNAMICS__MEAN_REVERSION_THRESHOLD=0.42
PERSONA__DYNAMICS__MEAN_REVERSION_STRENGTH=0.25
PERSONA__DYNAMICS__EXTREME_GUARD_MOOD_FLOOR=0.08
PERSONA__DYNAMICS__EXTREME_GUARD_STRESS_CEILING=0.92
PERSONA__DYNAMICS__EXTREME_GUARD_DARKNESS_CEILING=0.92
PERSONA__DYNAMICS__EXTREME_GUARD_RECOVERY_MULTIPLIER=1.08
PERSONA__DYNAMICS__SILENCE_MIN_ACTIVITY_SECONDS=30
PERSONA__DYNAMICS__SILENCE_FACTOR_REFERENCE_SECONDS=30
PERSONA__DYNAMICS__SILENCE_FACTOR_MAX=4
PERSONA__DYNAMICS__SILENCE_RECOVERY_MOOD=0.006
PERSONA__DYNAMICS__SILENCE_RECOVERY_STRESS=0.009
PERSONA__DYNAMICS__SILENCE_RECOVERY_DARKNESS=0.005
PERSONA__DYNAMICS__SILENCE_MAX_DELTA_MOOD=0.02
PERSONA__DYNAMICS__SILENCE_MAX_DELTA_STRESS=0.025
PERSONA__DYNAMICS__SILENCE_MAX_DELTA_DARKNESS=0.015
PERSONA__DYNAMICS__SILENCE_COLD_ROOM_SECONDS=120
PERSONA__DYNAMICS__SILENCE_COLD_ROOM_MOOD_DELTA=-0.0015
PERSONA__DYNAMICS__SILENCE_COLD_ROOM_STRESS_DELTA=0.001
# 动态锚点只消费累计房间聚合，禁止单条弹幕直接改写；以下值是“回归目标”的低幅偏置。
PERSONA__DYNAMICS__ANCHOR_MIN_ROOM_SAMPLES=6
PERSONA__DYNAMICS__ANCHOR_ROOM_MOOD_MAX=0.04
PERSONA__DYNAMICS__ANCHOR_ROOM_STRESS_MAX=0.025
PERSONA__DYNAMICS__ANCHOR_ROOM_DARKNESS_MAX=0.015
PERSONA__DYNAMICS__ANCHOR_LOAD_STRESS_MAX=0.03
PERSONA__DYNAMICS__ANCHOR_LOAD_RATE_REFERENCE=30
PERSONA__DYNAMICS__ANCHOR_UPDATE_MIN_DELTA=0.01
PERSONA__DYNAMICS__ANCHOR_MAX_UPDATES_PER_STREAM=24
# 事件余波：压力/阴暗会在有限窗口内缓慢衰减；重复同类事件递减，正向互动不能一轮清空余波。
PERSONA__DYNAMICS__AFTERGLOW_ENABLED=True
PERSONA__DYNAMICS__AFTERGLOW_HALF_LIFE_SECONDS=180
PERSONA__DYNAMICS__AFTERGLOW_APPLY_RATIO=0.20
PERSONA__DYNAMICS__AFTERGLOW_CAPTURE_RATIO=0.40
PERSONA__DYNAMICS__AFTERGLOW_MAX_MOOD=0.05
PERSONA__DYNAMICS__AFTERGLOW_MAX_STRESS=0.06
PERSONA__DYNAMICS__AFTERGLOW_MAX_DARKNESS=0.05
PERSONA__DYNAMICS__AFTERGLOW_POSITIVE_RELIEF_MULTIPLIER=0.45
PERSONA__DYNAMICS__REPEATED_EVENT_DECAY=0.15
PERSONA__DYNAMICS__REPEATED_EVENT_MIN_SCALE=0.45

# 直播排期与主题；JSON 值必须保持单行
STREAM__TIMEZONE=Asia/Shanghai
STREAM__WEEKLY_SCHEDULE={"monday":[{"start":"06:00","end":"03:00"}],"tuesday":[{"start":"06:00","end":"03:00"}],"wednesday":[{"start":"06:00","end":"03:00"}],"thursday":[{"start":"06:00","end":"03:00"}],"friday":[{"start":"06:00","end":"03:00"}],"saturday":[{"start":"06:00","end":"03:00"}],"sunday":[{"start":"06:00","end":"03:00"}]}
# stream_plan 是按场次冻结的配置快照；不要放当前进度、历史决策或 cooldown
STREAM__DAILY_THEMES=[{"id":"chat","name":"互联网杂谈","prompt_hint":"偶尔聊聊网络见闻。"},{"id":"game-night","name":"游戏实况","stream_plan":{"schema_version":1,"profile_id":"game-stream-v1","direction":"以推进游戏为主，允许自然聊天、短暂偏航并回归。","opening_beat_id":"opening","closing_beat_id":"wrap_up","beats":[{"beat_id":"opening","kind":"opening","label":"进入直播状态","objective":"自然开始游戏直播","compatible_activity_ids":["super-mario"]},{"beat_id":"main_gameplay","kind":"mainline","label":"认真推进游戏","objective":"保持游戏直播主线","compatible_activity_ids":["super-mario"]},{"beat_id":"chat_detour","kind":"detour","label":"和观众聊一会儿","objective":"短暂响应现场话题","compatible_activity_ids":["free-chat"],"return_to":"main_gameplay","return_policy":"natural"},{"beat_id":"wrap_up","kind":"wrap_up","label":"自然收尾","objective":"结束本场直播","compatible_activity_ids":["super-mario","free-chat"]}]}}]
# mood_bias 是 -0.2 到 0.2 的归一化小数，不是百分数；它调整本场持久化的情绪回归锚点，
# 不会在刷新元数据或重启恢复时重复叠加到当前状态；无效项会回退普通主题
STREAM__SPECIAL_DATE_THEMES=[{"id":"miku-birthday","date":"08-31","name":"初音未来生日","title":"今天是世界第一公主殿下的生日","priority":80,"mood_bias":{"mood":0.08,"stress":-0.02,"darkness":-0.03},"prompt_hint":"可以自然提到初音未来生日，但不要每句话重复。","idle_state_hint":"miku_birthday_idle","frontend_theme":"miku_day"}]
STREAM__IDLE_STATE_MIN_DURATION_SECONDS=60

# 独立主播微动作（默认关闭）；只在直播空闲时发送 streamer_beat，不调用模型，
# 有 SC、AI 回复等待、弹幕繁忙或客户端输出拥塞时会自动跳过且不会补发。
STREAM__BEAT_ENABLED=False
STREAM__BEAT_EVALUATION_INTERVAL_SECONDS=30
STREAM__BEAT_MIN_INTERVAL_SECONDS=120
STREAM__BEAT_MAX_PER_STREAM=6
STREAM__BEAT_LOW_ACTIVITY_MAX_RATE=3
STREAM__BEAT_SLOW_CONSUMER_QUEUE_THRESHOLD=1

# 主线事实层：Plan 快照与当前 Beat 的持久化，以及元数据里的 session_theme /
# daily_stream_plan / current_mainline_beat 公开字段。设为 False 即回到无主线行为，
# Director 随之空转，可作为只改 .env 的回退开关。
STREAM__MAINLINE_ENABLED=True
# 直播中是否用本场冻结快照改写公开的 daily_theme_*。默认关闭：旧字段继续跟随
# 实时配置，前端应以 session_theme 判断本场主题。
STREAM__MAINLINE_THEME_PROJECTION_ENABLED=False
# 是否向人格 Prompt 注入本场主线事实。与 PERSONA__REPLY_PLAN_INJECTION_ENABLED
# 一样按灰度开启：先观察 shadow/deterministic 效果，再打开注入。
STREAM__MAINLINE_PROMPT_INJECTION_ENABLED=False

# 每日直播主线 Director。安全默认：关闭、shadow、保留 legacy Activity evaluator。
# 建议依次启用：enabled+shadow -> deterministic -> activity_driver=director -> ai_shadow -> ai。
STREAM__DIRECTOR_ENABLED=False
STREAM__DIRECTOR_MODE=shadow
STREAM__DIRECTOR_ACTIVITY_DRIVER=legacy
STREAM__DIRECTOR_TICK_SECONDS=300
STREAM__DIRECTOR_QUEUE_CAPACITY=32
STREAM__DIRECTOR_TRIGGER_COALESCE_SECONDS=30
STREAM__DIRECTOR_OPENING_MIN_SECONDS=120
STREAM__DIRECTOR_DETOUR_RETURN_MIN_SECONDS=600
STREAM__DIRECTOR_QUIET_SECONDS=180
STREAM__DIRECTOR_WRAP_UP_SECONDS=600
STREAM__DIRECTOR_FACT_COOLDOWN_SECONDS=300
STREAM__DIRECTOR_PUBLIC_ACTION_COOLDOWN_SECONDS=300
STREAM__DIRECTOR_SPEAK_COOLDOWN_SECONDS=900
STREAM__DIRECTOR_MAX_PUBLIC_ACTIONS_PER_STREAM=8
STREAM__DIRECTOR_MAX_SPEAKS_PER_STREAM=3
STREAM__DIRECTOR_PERFORMANCE_ENABLED=False
STREAM__DIRECTOR_AI_MIN_INTERVAL_SECONDS=900
STREAM__DIRECTOR_AI_MAX_PER_STREAM=3
STREAM__DIRECTOR_AI_ROLLOUT_PERCENT=0
STREAM__DIRECTOR_AI_SPEAK_POLISH_ENABLED=False

# 已内置的待机类别会产生 offline/gaming/music_chat/variety/chatting/dark/
# stressed/tired/excited/chatty；特殊日期可用 idle_state_hint 自定义前端动画 ID。
# 未识别 ID 必须由前端回退静态默认状态。

# 多语言与英文首次互动梗。该梗只影响本轮提示词，不是公开 API 字段。
STREAM__LANGUAGE_DETECTION_MIN_CONFIDENCE=0.65
STREAM__LANGUAGE_DETECTION_MIN_SCRIPT_CHARS=3
STREAM__ENGLISH_SURPRISE_JOKE_ENABLED=True
STREAM__ENGLISH_SURPRISE_JOKE_PROBABILITY=0.35
STREAM__ENGLISH_SURPRISE_JOKE_MAX_PER_STREAM=3

# 场次总结：默认只冻结脱敏事实并入队，不会调用外部 AI。
# 只有显式开启 AI 后，空闲时的独立低优先级 worker 才会处理 pending 任务。
SESSION_SUMMARY__CAPTURE_ENABLED=True
SESSION_SUMMARY__AI_ENABLED=False
SESSION_SUMMARY__MAX_ATTEMPTS=2
SESSION_SUMMARY__PROCESSING_LEASE_SECONDS=300
SESSION_SUMMARY__POLL_INTERVAL_SECONDS=5
SESSION_SUMMARY__AI_TIMEOUT_SECONDS=45
SESSION_SUMMARY__PROMPT_CHARS=180
SESSION_SUMMARY__RETENTION_DAYS=30

# 主播情景记忆：候选采集不增加回复调用；AI worker 默认关闭，验证后再开启。
EPISODIC_MEMORY__ENABLED=True
EPISODIC_MEMORY__AI_ENABLED=False
EPISODIC_MEMORY__MAX_ATTEMPTS=3
EPISODIC_MEMORY__PROCESSING_LEASE_SECONDS=300
EPISODIC_MEMORY__POLL_INTERVAL_SECONDS=5
EPISODIC_MEMORY__AI_TIMEOUT_SECONDS=60
EPISODIC_MEMORY__MAX_CANDIDATES_PER_SESSION=48
EPISODIC_MEMORY__BATCH_SIZE=8
EPISODIC_MEMORY__MAX_BATCHES_PER_TASK=32
EPISODIC_MEMORY__RETRY_BACKOFF_SECONDS=30
EPISODIC_MEMORY__RETRY_BACKOFF_MAX_SECONDS=1800
EPISODIC_MEMORY__RECONCILIATION_BATCH_SIZE=100
EPISODIC_MEMORY__ERROR_DETAIL_MAX_CHARS=320
EPISODIC_MEMORY__MAX_CANDIDATES_PER_ACCOUNT=5
EPISODIC_MEMORY__MAX_MEMORIES_PER_SESSION=12
EPISODIC_MEMORY__MAX_MEMORIES_PER_ACCOUNT=3
EPISODIC_MEMORY__ACCOUNT_RETENTION_DAYS=180
EPISODIC_MEMORY__ROOM_RETENTION_DAYS=90
EPISODIC_MEMORY__REFLECTION_RETENTION_DAYS=90
EPISODIC_MEMORY__RETRIEVAL_ACCOUNT_LIMIT=2
EPISODIC_MEMORY__RETRIEVAL_ROOM_LIMIT=1
EPISODIC_MEMORY__RETRIEVAL_PROMPT_CHARS=500
EPISODIC_MEMORY__BACKFILL_ACCOUNT_LINK_START_DATE=2026-07-30

# 主播工作记忆（prompt RAM）：秒/分钟级、场次内、未闭合的意图。
# 纯进程内、重启即清空；默认关闭，关闭时提示词与开关引入前逐字节一致。
# 念头原文只在 GET /admin/prompt-ram 可见，不进 WS 广播、不进数据库。
PROMPT_RAM__ENABLED=false
PROMPT_RAM__NOTE_MAX_CHARS=80
PROMPT_RAM__MAX_ENTRIES=24
PROMPT_RAM__INJECT_MAX_ENTRIES=4
PROMPT_RAM__HARVEST_MAX_PER_REPLY=2
PROMPT_RAM__AWAITING_TTL_SECONDS=180
PROMPT_RAM__FOLLOWUP_TTL_SECONDS=300
PROMPT_RAM__IDEA_TTL_SECONDS=420
PROMPT_RAM__FULFILLED_GRACE_SECONDS=45
PROMPT_RAM__SELECTOR_BONUS=0.15
PROMPT_RAM__PURGE_INTERVAL_SECONDS=30

# 自愿赞助入口与赞助者感谢墙：纯展示旁路，赞助不授予任何功能权益。
# ENABLED 只控制页面底部入口，SYNC_ENABLED 才会去爱发电拉名单；
# 开启 SYNC_ENABLED 时必须同时填 USER_ID 与 TOKEN，否则启动即报错。
SPONSOR__ENABLED=False
SPONSOR__SYNC_ENABLED=False
SPONSOR__PLATFORM_NAME=爱发电
SPONSOR__PLATFORM_URL=
# 凭据来自爱发电开发者后台 https://afdian.net/dashboard/dev
# 仅服务端使用，不出现在任何 HTTP 响应或日志里；切勿把真实值提交进仓库。
SPONSOR__AFDIAN_USER_ID=
SPONSOR__AFDIAN_TOKEN=
SPONSOR__SYNC_INTERVAL_SECONDS=900
SPONSOR__SYNC_TIMEOUT_SECONDS=15
SPONSOR__SYNC_MAX_PAGES=20
SPONSOR__SYNC_BACKOFF_SECONDS=60
SPONSOR__SYNC_MAX_BACKOFF_SECONDS=3600
SPONSOR__LIST_LIMIT=200
SPONSOR__LIST_CACHE_SECONDS=60
SPONSOR__MAX_DISPLAY_NAME_CHARS=24
SPONSOR__ANONYMOUS_DISPLAY_NAME=匿名赞助者
# 昵称命中关键词即匿名化；有人要求撤下时把爱发电 user_id 加进 HIDDEN 列表，
# 下一次同步会把已有记录一并标记为隐藏。
SPONSOR__ANONYMOUS_KEYWORDS=["匿名","不上墙","anonymous"]
SPONSOR__HIDDEN_PLATFORM_USER_IDS=[]
# 展示文案由后端驱动，改文案不需要重新发布前端。
# SPONSOR__NOTICE_TEXT=AI 接口成本涨了不少，为爱发电有点吃力。赞助完全自愿，不解锁任何功能，也不会影响弹幕、SC 或回复优先级。

# 跨域前端（按实际域名替换；凭据模式禁止 *）
CORS__ALLOWED_ORIGINS=["http://localhost:5173"]
CORS__ALLOW_CREDENTIALS=True

# Nginx 反向代理：信任代理 IP，从 X-Forwarded-For 提取真实客户端 IP。
# 不配置则所有连接被识别为同一 IP，ws_max_ip_connections 限制会卡住总连接数。
# 多个代理用逗号分隔，如 ["127.0.0.1/32","10.0.0.0/8"]
RATE_LIMIT__TRUSTED_PROXY_CIDRS=["127.0.0.1/32"]
# 浏览器登录态：两个 Cookie 均为 HttpOnly；前端不读取、复制或持久化 token。
# access 用于普通 HTTP/WebSocket 鉴权；refresh 仅随 POST /auth/refresh 发送并每次轮换。
# 本地 HTTP 默认使用 lax；生产 HTTPS + 跨站前端时再改为 Secure/None/Partitioned。
AUTH__COOKIE_SECURE=False
AUTH__COOKIE_SAMESITE=lax
AUTH__COOKIE_PARTITIONED=False
AUTH__ACCESS_TOKEN_TTL_HOURS=168
AUTH__REFRESH_TOKEN_TTL_HOURS=720
AUTH__COOKIE_NAME=kangel_access_token
AUTH__REFRESH_COOKIE_NAME=kangel_refresh_token

# Token 审计与管理后台
# 审计默认开启，只记账、不改任何回复行为：回复路径上只有一次内存入队，
# 落库在后台任务里；写库失败只影响审计自身。TOKEN_AUDIT__ENABLED=False
# 就是纯 .env 回退路径（记录直接返回、flush 任务不启动、接口返回空数据）。
# 明细表按 DETAIL_RETENTION_DAYS 自动清理，每日聚合表永久保留。
# 明细里没有 prompt、回复正文、message_id、昵称或 IP；失败行只记异常类名。
TOKEN_AUDIT__ENABLED=True
TOKEN_AUDIT__DETAIL_ENABLED=True
TOKEN_AUDIT__DETAIL_RETENTION_DAYS=14
TOKEN_AUDIT__FLUSH_INTERVAL_SECONDS=5
TOKEN_AUDIT__FLUSH_BATCH_SIZE=200
TOKEN_AUDIT__QUEUE_CAPACITY=2000
TOKEN_AUDIT__PURGE_INTERVAL_SECONDS=3600

# 价目表：每 100 万 token 的单价，只用于读取时折算花费，不参与调用决策。
# 金额按当前价目表现算而不落库，所以补价或改价后历史金额自动跟着变。
# 同一份配置里 currency 必须一致（混币无法求和，启动时会直接报错）。
# 未列出的模型显示「未配价」，不会按 0 混进总额；"*" 是兜底项。
# cached_input_per_1m 不配时缓存 token 按原价计。JSON 必须保持单行。
# AI__PRICING=[{"model":"Pro/MiniMaxAI/MiniMax-M2.5","input_per_1m":2.0,"output_per_1m":8.0,"cached_input_per_1m":0.4,"currency":"CNY"},{"model":"*","input_per_1m":1.0,"output_per_1m":4.0,"currency":"CNY"}]

# 管理后台：默认整体关闭，此时 /admin/* 与 /admin/ui 一律返回 404。
# API_KEY 必须是强随机值（如 python -c "import secrets;print(secrets.token_urlsafe(32))"），
# 与普通账号登录令牌严格分离；仅服务端使用，切勿提交真实值。
# 后台一个面板就是一次请求，比 curl 密集，开启时建议放宽默认桶（30/分钟、burst 10）。
ADMIN__ENABLED=False
ADMIN__API_KEY=
ADMIN__RATE_PER_MINUTE=120
ADMIN__BURST=40
ADMIN__CONCURRENCY=2
