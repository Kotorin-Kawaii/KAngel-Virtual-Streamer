# Server
SERVER__HOST=0.0.0.0
SERVER__PORT=8000
SERVER__RELOAD=False
SERVER__LOG_LEVEL=info

# OpenAI-compatible AI service
AI__BASE_URL=https://api.example.com/v1
AI__API_KEY=replace-me
AI__DEFAULT_MODEL=replace-with-your-reply-model
AI__QA_SELECTOR_MODEL=replace-with-your-fast-model
AI__QA_SELECTOR_TIMEOUT=12
AI__DANMAKU_SELECTOR_MODEL=replace-with-your-fast-model
AI__DANMAKU_SELECTOR_TIMEOUT=12
AI__IMPACT_ANALYSIS_MODEL=replace-with-your-balanced-model
AI__IMPACT_ANALYSIS_TIMEOUT=20
AI__PARALLEL_CONTEXT_ANALYSIS=True
AI__TEMPERATURE=0.2
AI__STREAMING=False
AI__TIMEOUT=600

# Browser frontend
CORS__ALLOWED_ORIGINS=["http://localhost:5173"]
CORS__ALLOW_CREDENTIALS=True
AUTH__COOKIE_SECURE=False
AUTH__COOKIE_SAMESITE=lax
AUTH__COOKIE_PARTITIONED=False

# Persona
PERSONA__STREAMER_NAME=超天酱
PERSONA__THEME=粉色系
PERSONA__INITIAL_MOOD=0.6
PERSONA__INITIAL_DARKNESS=0.2
PERSONA__INITIAL_STRESS=0.3
PERSONA__REPLY_AGGRESSIVENESS=0.4
PERSONA__IGNORE_PROBABILITY=0.1

# Daily stream schedule; an end earlier than start crosses midnight
STREAM__TIMEZONE=Asia/Shanghai
STREAM__WEEKLY_SCHEDULE={"monday":[{"start":"06:00","end":"03:00"}],"tuesday":[{"start":"06:00","end":"03:00"}],"wednesday":[{"start":"06:00","end":"03:00"}],"thursday":[{"start":"06:00","end":"03:00"}],"friday":[{"start":"06:00","end":"03:00"}],"saturday":[{"start":"06:00","end":"03:00"}],"sunday":[{"start":"06:00","end":"03:00"}]}
STREAM__DAILY_THEMES=[{"id":"chat","name":"互联网杂谈","prompt_hint":"偶尔聊聊网络见闻。"},{"id":"game","name":"游戏闲聊"}]

# Registered viewer memory prompt budget
MEMORY__PROMPT_FRAGMENT_LIMIT=3
MEMORY__PROMPT_SUMMARY_LIMIT=1
MEMORY__PROMPT_FRAGMENT_CHARS=160
MEMORY__PROMPT_SUMMARY_CHARS=240

# SC and emotes
SC__COOLDOWN_SECONDS=300
SC__MAX_CONTENT_CHARS=500
SC__MAX_PENDING_ITEMS=100
EMOTES__ALLOWED_IDS=["love","ok","pien"]
EMOTES__COOLDOWN_SECONDS=3

# Single-process protection
RATE_LIMIT__PROFILE=public
RATE_LIMIT__ENABLED=True
RATE_LIMIT__WS_IDLE_TIMEOUT_SECONDS=0
RATE_LIMIT__WS_MAX_LIFETIME_SECONDS=0
RATE_LIMIT__AI_REPLY_QUEUE_SIZE=8
RATE_LIMIT__AI_REPLY_QUEUE_WAIT_SECONDS=2
RATE_LIMIT__AI_SELECTOR_CONCURRENCY=4
RATE_LIMIT__AI_REPLY_CONCURRENCY=2

# Sensitive admin routes are disabled by default
ADMIN__ENABLED=False
ADMIN__API_KEY=
